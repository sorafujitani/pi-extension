{
  "name": "pi-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Personal extensions for the pi coding agent.",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "README.md"
  ],
  "type": "module",
  "dependencies": {
    "jiti": "2.7.0",
    "pi-btw": "0.7.1",
    "safe-regex": "^2.1.1"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/safe-regex": "^1.1.6",
    "typebox": "^1.3.7",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "pnpm@11.22.0",
  "pi": {
    "extensions": [
      "./extensions",
      "!extensions/host-compat.ts",
      "!extensions/expose-tool.ts"
    ]
  }
}
