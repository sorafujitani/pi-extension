{
  "name": "pi-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Personal extensions for the pi coding agent.",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "README.md"
  ],
  "type": "module",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
